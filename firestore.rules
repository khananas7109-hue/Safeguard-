rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Functions
    function isSignedIn() { 
      return request.auth != null; 
    }
    
    function isOwner(userId) { 
      return isSignedIn() && request.auth.uid == userId; 
    }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    // --- User Profile ---
    function isValidUser(data) {
      return data.phoneNumber is string && data.phoneNumber.size() <= 30
          && (data.get('displayName', '') is string && data.get('displayName', '').size() <= 128)
          && (data.get('photoURL', '') is string && data.get('photoURL', '').size() <= 1024);
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming())
                   && incoming().phoneNumber == request.auth.token.phone_number;
      allow update: if isOwner(userId) && isValidUser(incoming())
                   && incoming().phoneNumber == existing().phoneNumber
                   && incoming().diff(existing()).affectedKeys().hasAny(['displayName', 'photoURL', 'updatedAt'])
                   && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt']);

      // --- Contacts ---
      match /contacts/{contactId} {
        function isValidContact(data) {
          return data.name is string && data.name.size() > 0 && data.name.size() <= 128
              && data.phone is string && data.phone.size() > 0 && data.phone.size() <= 30;
        }
        
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(contactId) && isValidContact(incoming());
        allow update: if isOwner(userId) && isValidContact(incoming());
        allow delete: if isOwner(userId);
      }

      // --- Evidence ---
      match /evidence/{evidenceId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(evidenceId)
                     && incoming().type in ['photo', 'audio']
                     && incoming().data is string
                     && incoming().timestamp is int;
        allow update, delete: if false; // Evidence is immutable
      }
    }

    // --- Location Shares ---
    match /shares/{shareId} {
      function isValidShare(data) {
        return data.userId is string && data.userId.size() <= 128
            && data.userName is string && data.userName.size() <= 128
            && data.location.latitude is number && data.location.longitude is number
            && data.battery is int
            && data.expiresAt is int
            && data.sharedWith is list
            && data.status in ['active', 'expired'];
      }

      allow create: if isSignedIn() && isValidShare(incoming()) 
                   && incoming().userId == request.auth.uid;
      
      allow get, list: if isSignedIn() && (
        resource.data.userId == request.auth.uid || 
        request.auth.token.phone_number in resource.data.sharedWith
      );

      allow update: if isSignedIn() && resource.data.userId == request.auth.uid
                   && isValidShare(incoming())
                   && incoming().userId == resource.data.userId
                   && (
                     incoming().diff(resource.data).affectedKeys().hasOnly(['location', 'battery', 'status', 'updatedAt']) ||
                     // for cleanup or auto-expire
                     incoming().diff(resource.data).affectedKeys().hasOnly(['status'])
                   );
    }
  }
}
